# Environment Configuration for Digital Mental Health Platform

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mental_health_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/mental_health_db

# Redis Configuration (for sessions and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Email Configuration (for notifications and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@mentalhealth-platform.com
FROM_NAME=Mental Health Platform

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# AI/ML Service Configuration
ML_SERVICE_URL=http://localhost:8000
HUGGING_FACE_API_KEY=your_huggingface_api_key
OPENAI_API_KEY=your_openai_api_key

# Crisis Detection Configuration
CRISIS_THRESHOLD=0.8
EMERGENCY_CONTACT_EMAIL=crisis@mentalhealth-platform.com
CRISIS_HELPLINE=9152987821

# Video Calling Configuration (for counselor sessions)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_secret

# Payment Gateway Configuration (if implementing paid consultations)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_CANCEL_URL=http://localhost:3000/payment/cancel

# Social Media Authentication (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn_url
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your_session_secret_key
SESSION_TIMEOUT=86400000

# Cloud Storage Configuration (AWS S3, etc.)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mental-health-platform-uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# Security Configuration
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

# Notification Configuration
PUSH_NOTIFICATION_KEY=your_push_notification_key
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_secret

# Machine Learning Model Paths
SENTIMENT_MODEL_PATH=./models/sentiment_model.pkl
CRISIS_MODEL_PATH=./models/crisis_detection_model.pkl
CHATBOT_MODEL_PATH=./models/chatbot_model

# Data Processing Configuration
DATA_PROCESSING_BATCH_SIZE=1000
MAX_CONCURRENT_PROCESSES=4

# Backup Configuration
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30